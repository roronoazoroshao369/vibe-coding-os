{
  "$schema": "https://json.schemastore.org/claude-code-plugin.json",
"name": "vibe-coding-os",
  "version": "2.17.7",
   "description": "Vibe Coding OS — a Claude/Codex-friendly AI coding skill framework for disciplined vibe coding. 115 skills, 116 commands, 107 templates, 11 validation gates, 9 CLI adapters, 22 inspiration sources.",
  "author": {
    "name": "Vibe Coding OS Maintainers",
    "url": "https://github.com/roronoazoroshao369/vibe-coding-os"
  },
  "license": "MIT",
  "homepage": "https://github.com/roronoazoroshao369/vibe-coding-os",
  "repository": "https://github.com/roronoazoroshao369/vibe-coding-os",
  "bugs": "https://github.com/roronoazoroshao369/vibe-coding-os/issues",
  "keywords": [
    "skills",
    "agents",
    "engineering",
    "spec",
    "tdd",
    "review",
    "ship",
    "vibe-coding",
    "claude-code",
    "codex",
    "cursor",
    "gemini"
  ],
  "categories": [
    "spec-driven-development",
    "test-driven-development",
    "code-review",
    "architecture",
    "security",
    "observability",
    "performance",
    "deprecation",
    "threat-modeling",
    "vertical-slicing"
  ],
  "components": {
    "skills": {
      "directory": "skills/",
      "count": 115,
      "manifest": "registry/skills.json"
    },
    "commands": {
      "directory": "commands/",
      "count": 116,
      "manifest": "commands/manifest.json"
    },
    "templates": {
      "directory": "templates/",
      "count": 107,
      "manifest": "schemas/template-manifest.schema.json"
    },
    "registry": {
      "directory": "registry/",
      "files": [
        "skills.json",
        "skill-categories.json",
        "bundles.json",
        "sources.json",
        "bypass-techniques.json",
        "cipher-attack-detection.json",
        "scanner-patterns.json",
        "deprecation-tracker.json"
      ]
    },
    "schemas": {
      "directory": "schemas/",
      "primary": "schemas/skill.schema.json"
    },
    "adapters": {
      "directory": "adapters/",
      "supported": [
        "claude-code",
        "codex",
        "cursor",
        "gemini",
        "aider",
        "cline",
        "continue",
        "windsurf",
        "mcp",
        "memory",
        "hooks"
      ]
    }
  },
  "entrypoints": {
    "init": "commands/vibe-init.md",
    "doctor": "commands/vibe-doctor.md",
    "help": "commands/vibe-help.md"
  },
  "validation": {
    "command": "npm run validate:all",
    "gates": 12,
    "expected": "PASS"
  },
  "inspiration_sources": {
    "count": 22,
    "manifest": "references/index.json"
  },
  "runtime": {
    "frozen": true,
    "policy": "docs/adr/0002-runtime-freeze.md",
    "allowlist": "registry/runtime-freeze-allowlist.json"
  },
  "attribution": {
    "file": "ATTRIBUTIONS.md",
    "notices": "NOTICE.md"
  }
}