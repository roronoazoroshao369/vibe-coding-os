{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/runtime-task.schema.json",
  "title": "Vibe Coding OS Runtime Task Item",
  "description": "Item shape for tasks persisted under the optional runtime layer.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "runtime-common.schema.json#/$defs/runtimeId"
    },
    "title": {
      "type": "string",
      "description": "Human-readable task title"
    },
    "status": {
      "$ref": "runtime-common.schema.json#/$defs/taskStatusEnum"
    },
    "dependsOn": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "owner": {
      "type": "string"
    },
    "createdAt": {
      "$ref": "runtime-common.schema.json#/$defs/isoDateTime"
    },
    "updatedAt": {
      "$ref": "runtime-common.schema.json#/$defs/isoDateTime"
    },
    "source": {
      "$ref": "runtime-common.schema.json#/$defs/source"
    },
    "metadata": {
      "$ref": "runtime-common.schema.json#/$defs/metadata"
    },
    "tags": {
      "$ref": "runtime-common.schema.json#/$defs/tags"
    }
  },
  "required": ["id", "title", "status"]
}
