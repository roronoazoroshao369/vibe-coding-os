{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/runtime-session.schema.json",
  "title": "Vibe Coding OS Runtime Session Item",
  "description": "Item shape for sessions persisted under the optional runtime layer.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "runtime-common.schema.json#/$defs/runtimeId"
    },
    "goal": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "createdAt": {
      "$ref": "runtime-common.schema.json#/$defs/isoDateTime"
    },
    "updatedAt": {
      "$ref": "runtime-common.schema.json#/$defs/isoDateTime"
    },
    "metadata": {
      "$ref": "runtime-common.schema.json#/$defs/metadata"
    }
  },
  "required": ["id", "goal", "createdAt"]
}
