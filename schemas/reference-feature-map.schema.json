{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/reference-feature-map.schema.json",
  "title": "Vibe Coding OS Reference Feature Map",
  "description": "Tracks upstream feature adoption and audit freshness.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "last_checked", "status", "url"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "last_checked": { "type": "string", "format": "date-time" },
          "status": { "type": "string", "enum": ["active", "deprecated", "unavailable"] },
          "url": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": true
      }
    },
    "last_audit": { "type": "string", "format": "date-time" },
    "metadata": { "type": "object", "additionalProperties": true },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "required": ["schemaVersion", "source_id", "features"]
}
