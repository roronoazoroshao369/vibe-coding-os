{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/runtime-collection.schema.json",
  "title": "Vibe Coding OS Runtime Collection",
  "description": "Minimal persisted runtime collection contract for optional local runtime state files under .omc/runtime.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "items"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": ["tasks", "memory", "checkpoints", "teams", "sessions", "workflow-runs", "actions", "events", "approvals"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "contractVersion": {
      "type": "string",
      "description": "Contract version identifier for the collection"
    },
    "runtimeId": {
      "$ref": "runtime-common.schema.json#/$defs/runtimeId",
      "description": "Runtime instance identifier"
    },
    "revision": {
      "type": "integer",
      "description": "Revision number for the collection"
    },
    "metadata": {
      "$ref": "runtime-common.schema.json#/$defs/metadata",
      "description": "Arbitrary metadata for the collection (escape hatch)"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true,
      "description": "Arbitrary extensions for the collection (escape hatch)"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": { "const": "tasks" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-task.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "memory" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-memory.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "checkpoints" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-checkpoint.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "teams" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-team.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "sessions" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-session.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "workflow-runs" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "workflow-run.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "actions" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-action.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "events" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-event.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "approvals" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-approval.schema.json"
            }
          }
        }
      }
    }
  ]
}
