{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/runtime-collection.schema.json",
  "title": "Vibe Coding OS Runtime Collection",
  "description": "Minimal persisted runtime collection contract for optional local runtime state files under .omc/runtime.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "kind", "items"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "type": "string",
      "enum": ["tasks", "memory", "checkpoints", "teams", "sessions"]
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": { "const": "tasks" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-task.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "memory" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-memory.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "checkpoints" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-checkpoint.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "teams" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-team.schema.json"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": { "const": "sessions" }
        },
        "required": ["kind"]
      },
      "then": {
        "properties": {
          "items": {
            "items": {
              "$ref": "runtime-session.schema.json"
            }
          }
        }
      }
    }
  ]
}
