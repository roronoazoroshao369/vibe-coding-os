{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/runtime-common.schema.json",
  "title": "Vibe Coding OS Runtime Common Types",
  "description": "Shared schema definitions for optional runtime layer persisted state.",
  "$defs": {
    "isoDateTime": {
      "type": "string",
      "format": "date-time"
    },
    "runtimeId": {
      "type": "string",
      "minLength": 1
    },
    "taskStatusEnum": {
      "type": "string",
      "enum": ["pending", "in_progress", "blocked", "completed", "cancelled"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceV1": {
      "type": "string"
    },
    "createdBy": {
      "type": ["object", "string"],
      "properties": {
        "type": { "type": "string", "enum": ["human", "agent", "system", "mcp", "daemon"] },
        "id": { "type": "string" },
        "label": { "type": "string" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "sourceV2": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["cli", "mcp", "daemon", "tmux", "import", "manual"] },
        "ref": { "type": "string" },
        "path": { "type": "string" }
      },
      "required": ["type"],
      "additionalProperties": false
    },
    "trace": {
      "type": ["object", "string"],
      "properties": {
        "sessionId": { "$ref": "#/$defs/runtimeId" },
        "workflowRunId": { "$ref": "#/$defs/runtimeId" },
        "taskId": { "$ref": "#/$defs/runtimeId" },
        "parentEventId": { "$ref": "#/$defs/runtimeId" }
      },
      "additionalProperties": false
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": { "type": "string", "enum": ["safe", "review", "dangerous", "blocked"] },
        "approvalRequired": { "type": "boolean" },
        "reasons": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["level"],
      "additionalProperties": false
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
