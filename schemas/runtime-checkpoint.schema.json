{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/runtime-checkpoint.schema.json",
  "title": "Vibe Coding OS Runtime Checkpoint Item (v2)",
  "description": "Item shape for checkpoints persisted under the optional runtime layer. v2 adds structured subject, evidence, decision, and resumeHint.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "runtime-common.schema.json#/$defs/runtimeId"
    },
    "type": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "subject": {
      "type": "string",
      "description": "Subject identifier (string, for backward compatibility)"
    },
    "subjectType": {
      "type": "string",
      "enum": ["task", "workflow-run", "session", "team", "artifact"],
      "description": "Structured subject type"
    },
    "subjectId": {
      "$ref": "runtime-common.schema.json#/$defs/runtimeId",
      "description": "Structured subject runtime ID"
    },
    "notes": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "description": "Which phase the checkpoint gates (constitution/specify/plan/tasks/implementation)"
    },
    "command": {
      "type": "string",
      "description": "The command that produced this checkpoint"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "skipped"],
      "description": "Gate status for the checkpoint"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": { "type": "string", "enum": ["command", "file", "review", "manual-note"] },
          "ref": { "type": "string" },
          "status": { "type": "string", "enum": ["passed", "failed", "blocked", "skipped"] },
          "timestamp": { "$ref": "runtime-common.schema.json#/$defs/isoDateTime" }
        },
        "additionalProperties": false
      },
      "description": "Evidence items supporting this checkpoint"
    },
    "decision": {
      "type": "object",
      "properties": {
        "approved": { "type": "boolean" },
        "approvedBy": { "type": "string" },
        "reason": { "type": "string" }
      },
      "additionalProperties": false,
      "description": "Decision record for this checkpoint"
    },
    "resumeHint": {
      "type": "string",
      "description": "Instructions for resuming after this checkpoint (camelCase, v2+)"
    },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths or references to artifacts produced during the phase"
    },
    "limitations": {
      "type": "string",
      "description": "What this checkpoint does not verify"
    },
    "resume_hint": {
      "type": "string",
      "description": "Instructions for resuming after this checkpoint (snake_case, legacy compat)"
    },
    "created_by": {
      "type": "string",
      "description": "Agent or user that created the checkpoint"
    },
    "createdBy": {
      "$ref": "runtime-common.schema.json#/$defs/createdBy"
    },
    "source": {
      "type": "string"
    },
    "trace": {
      "$ref": "runtime-common.schema.json#/$defs/trace"
    },
    "createdAt": {
      "$ref": "runtime-common.schema.json#/$defs/isoDateTime"
    },
    "metadata": {
      "$ref": "runtime-common.schema.json#/$defs/metadata"
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": ["id", "type", "result"]
}
