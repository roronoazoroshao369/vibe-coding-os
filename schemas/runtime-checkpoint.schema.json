{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/runtime-checkpoint.schema.json",
  "title": "Vibe Coding OS Runtime Checkpoint Item",
  "description": "Item shape for checkpoints persisted under the optional runtime layer.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1
    },
    "id": {
      "$ref": "runtime-common.schema.json#/$defs/runtimeId"
    },
    "type": {
      "type": "string"
    },
    "result": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "phase": {
      "type": "string",
      "description": "Which phase the checkpoint gates (constitution/specify/plan/tasks/implementation)"
    },
    "command": {
      "type": "string",
      "description": "The command that produced this checkpoint"
    },
    "status": {
      "type": "string",
      "enum": ["passed", "failed", "blocked", "skipped"],
      "description": "Gate status for the checkpoint"
    },
    "artifact_refs": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths or references to artifacts produced during the phase"
    },
    "limitations": {
      "type": "string",
      "description": "What this checkpoint does not verify"
    },
    "resume_hint": {
      "type": "string",
      "description": "Instructions for resuming after this checkpoint"
    },
    "created_by": {
      "type": "string",
      "description": "Agent or user that created the checkpoint"
    },
    "createdAt": {
      "$ref": "runtime-common.schema.json#/$defs/isoDateTime"
    },
    "metadata": {
      "$ref": "runtime-common.schema.json#/$defs/metadata"
    }
  },
  "required": ["id", "type", "result"]
}
