{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vibe-coding-os.local/schemas/property-based-test.schema.json",
  "title": "Property-Based Test Definition",
  "description": "Contract for property-based test definitions used by the property-test-runner. Each test defines invariants, generators, input space, and expected properties that must hold for skills, commands, or templates under fuzz testing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "description",
    "target",
    "properties",
    "generators",
    "invariants"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "Unique test name — used as identifier in reports and CI."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Human-readable description of what this property test validates."
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "path"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["skill", "command", "template"],
          "description": "Artifact type to test."
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Relative path to the skill/command/template file."
        },
        "required_sections": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Markdown sections that must exist in the target (e.g., '## Purpose', '## Workflow')."
        }
      },
      "description": "The artifact being tested: which skill, command, or template, and what sections to verify."
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Property/invariant name used in results."
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What this property asserts about the target."
          },
          "category": {
            "type": "string",
            "enum": ["structural", "content", "behavioral", "consistency", "completeness"],
            "description": "Classification of the property being tested.",
            "default": "structural"
          }
        }
      },
      "description": "List of properties or invariants that must hold for this target."
    },
    "generators": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_space"],
      "properties": {
        "input_space": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimensions"],
          "properties": {
            "dimensions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "type"],
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Dimension name (e.g., 'heading_level', 'line_length', 'section_count')."
                  },
                  "type": {
                    "type": "string",
                    "enum": ["integer", "string", "boolean", "enum", "text_block"],
                    "description": "Data type for this dimension."
                  },
                  "min": {
                    "type": "integer",
                    "description": "Minimum value (for integer dimensions)."
                  },
                  "max": {
                    "type": "integer",
                    "description": "Maximum value (for integer dimensions)."
                  },
                  "values": {
                    "type": "array",
                    "items": { "type": "string" },
                    "description": "Allowed values (for enum dimensions)."
                  },
                  "nullable": {
                    "type": "boolean",
                    "description": "Whether this dimension can be absent/null.",
                    "default": false
                  },
                  "description": {
                    "type": "string",
                    "description": "Purpose of this input dimension."
                  }
                }
              },
              "description": "Dimensions defining the input space for fuzz testing."
            },
            "generation_strategy": {
              "type": "string",
              "enum": ["random", "exhaustive", "boundary", "combinatorial"],
              "description": "Strategy for generating test inputs from the input space.",
              "default": "random"
            },
            "iterations": {
              "type": "integer",
              "minimum": 1,
              "default": 100,
              "description": "Number of random trials to run per test."
            }
          },
          "description": "Definition of the input space and generation strategy."
        }
      },
      "description": "Generator configuration for producing randomized test inputs."
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "assertion"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "Invariant name."
          },
          "assertion": {
            "type": "string",
            "minLength": 1,
            "description": "The condition that must hold — expressed as a predicate description (checked by the runner)."
          },
          "category": {
            "type": "string",
            "enum": ["structural", "format", "content"],
            "description": "Invariant category.",
            "default": "structural"
          }
        }
      },
      "description": "Invariants that must hold for all generated inputs."
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Optional tags for filtering (e.g., 'markdown', 'skill', 'critical')."
    },
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this test runs by default."
    }
  }
}
